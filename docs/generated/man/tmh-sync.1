.SH NAME
tmh-sync - Reconcile live tmux and config.yml


.SH SYNOPSIS
\fBtmh sync [flags]\fP


.SH DESCRIPTION
Default direction is --push (live matches config). Use --pull to update
config from live, --bootstrap to import all live sessions into an empty config.


.SH OPTIONS
\fB--all\fP[=false]
	apply drifted/gone entries (default: skipped)

.PP
\fB--bootstrap\fP[=false]
	import all live sessions into empty config

.PP
\fB--dry-run\fP[=false]
	print actions without executing

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for sync

.PP
\fB--pull\fP[=false]
	config ← live (import new, rewrite drifted dirs)

.PP
\fB--push\fP[=false]
	live ← config (create missing sessions/windows)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to config.yml (overrides TMH_CONFIG and defaults)

.PP
\fB--lang\fP=""
	language override (en|ru); takes precedence over config and env

.PP
\fB--profile\fP=""
	profile name from config.yml


.SH SEE ALSO
\fBtmh(1)\fP


